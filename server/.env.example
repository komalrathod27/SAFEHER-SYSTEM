# ========================================================
# SafeHer Emergency System - Google Mail Configuration
# ========================================================
# To send real SOS emails via Google for free:
# 1. Open your Google Account (https://myaccount.google.com)
# 2. Go to "Security" -> Turn ON "2-Step Verification"
# 3. Go to "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an app named "SafeHer" and copy the 16-character code
# 5. Paste your Gmail address and 16-character App Password below:

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Server Port (optional, default 3000)
PORT=3000

# ========================================================
# SafeHer Emergency System - SMS Configuration
# ========================================================
# Tier 1: Developer's Mobile (Uses your daily 100 SMS recharge pack)
DEV_PHONE_NUMBER=9876543210
DEV_DAILY_SMS_LIMIT=100

# Tier 2: Backup Cloud SMS Gateway (Fast2SMS)
# If Dev's 100 SMS/day recharge expires, it automatically falls back to Fast2SMS:
FAST2SMS_API_KEY=
